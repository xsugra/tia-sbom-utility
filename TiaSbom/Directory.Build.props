<Project>
  <!--
    One source tree, one build per Openness API:
      TiaApi=V16  runs on TIA V16 - V19
      TiaApi=V17  runs on TIA V17 - V20
      TiaApi=V18, V19, V20  needed for the Add-In: PublicAPI\V17.AddIn has no publisher there (verified on V19)
      TiaApi=V21  runs on TIA V21 only (older assemblies are no longer shipped)
    TiaPortal = the installation that provides the DLLs at build time, e.g. -p:TiaApi=V17 -p:TiaPortal=V19.
  -->
  <PropertyGroup>
    <TiaApi Condition="'$(TiaApi)' == ''">V21</TiaApi>
    <TiaPortal Condition="'$(TiaPortal)' == ''">$(TiaApi)</TiaPortal>

    <!-- Openness V16 requires .NET Framework 4.6.2, V17 and later 4.8. -->
    <TargetFramework Condition="'$(TiaApi)' == 'V16'">net462</TargetFramework>
    <TargetFramework Condition="'$(TiaApi)' != 'V16'">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Company>YourCompany</Company>
    <Version>0.2.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Each API gets its own output, so builds do not overwrite each other. -->
    <BaseOutputPath>bin\$(TiaApi)\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\$(TiaApi)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>

    <!-- V21 moved the libraries to net48 and split them into modules. Override: dotnet build -p:TiaApiDir=... -->
    <TiaApiDir Condition="'$(TiaApiDir)' == '' And '$(TiaApi)' == 'V21'">C:\Program Files\Siemens\Automation\Portal $(TiaPortal)\PublicAPI\$(TiaApi)\net48</TiaApiDir>
    <TiaApiDir Condition="'$(TiaApiDir)' == ''">C:\Program Files\Siemens\Automation\Portal $(TiaPortal)\PublicAPI\$(TiaApi)</TiaApiDir>

    <!-- Before V21 the Add-In API lives next to the Openness API in a separate folder, e.g. PublicAPI\V17.AddIn. -->
    <TiaAddInApiDir Condition="'$(TiaApi)' == 'V21'">$(TiaApiDir)</TiaAddInApiDir>
    <TiaAddInApiDir Condition="'$(TiaApi)' != 'V21'">C:\Program Files\Siemens\Automation\Portal $(TiaPortal)\PublicAPI\$(TiaApi).AddIn</TiaAddInApiDir>

    <DefineConstants>$(DefineConstants);TIA_API_$(TiaApi)</DefineConstants>
    <!-- Multiuser sessions (LocalSessions, ProjectBase) are available from Openness V17. -->
    <DefineConstants Condition="'$(TiaApi)' != 'V16'">$(DefineConstants);TIA_HAS_SESSIONS</DefineConstants>
    <!-- Device.UnpluggedItems is documented from V19, but the V17 assembly has it too. V16 is not verified yet. -->
    <DefineConstants Condition="'$(TiaApi)' != 'V16'">$(DefineConstants);TIA_HAS_UNPLUGGED_ITEMS</DefineConstants>
  </PropertyGroup>

  <!-- Projects that set UseTiaOpenness=true reference all Siemens.Engineering.*.dll, never copied to output. -->
  <ItemGroup Condition="'$(UseTiaOpenness)' == 'true'">
    <Reference Include="$(TiaApiDir)\Siemens.Engineering*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckTiaApiDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseTiaOpenness)' == 'true' And !Exists('$(TiaApiDir)')">
    <Error Text="Openness API $(TiaApi) not found in '$(TiaApiDir)'. Set -p:TiaPortal=Vxx to an installed TIA Portal or -p:TiaApiDir=path." />
  </Target>
</Project>
