<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for TiaSbom.Core and TiaSbom.Gitea. They compile the production sources directly, so the same code runs on
    .NET 8 (WSL, Linux, no TIA) and on .NET Framework 4.8 (VM). NuGet packages are allowed here: this assembly never
    loads inside TIA Portal. The sandbox rules in CLAUDE.md apply to the production projects only.

      ./test.sh                   WSL, net8.0
      .\test.ps1                  Windows VM, net48 and net8.0

    Integration tests against a real Gitea run only when TIASBOM_TEST_GITEA_URL and TIASBOM_TEST_TOKEN are set.
  -->
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- Production code is compiled with the V21 constants, TiaBuild needs one of them. -->
    <DefineConstants>$(DefineConstants);TIA_API_V21</DefineConstants>
    <NoWarn>$(NoWarn);SYSLIB0014;SYSLIB0003;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\TiaSbom.Core\*.cs" Link="Production\Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TiaSbom.Gitea\*.cs" Exclude="..\..\src\TiaSbom.Gitea\TokenStore.cs" Link="Production\Gitea\%(Filename)%(Extension)" />
    <None Include="Schema\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <!-- Schema validation needs System.Text.Json, so it runs on .NET 8 only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="JsonSchema.Net" Version="7.2.3" />
  </ItemGroup>
</Project>
