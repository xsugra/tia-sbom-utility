# TiaSbom settings. Copy to tiasbom.env next to install.ps1 and fill in.
# tiasbom.env is never committed. After a change run install.cmd again.
# Format: KEY=VALUE, one per line. A # inside a value belongs to the value. %VAR% is expanded.

# Gitea address. Production must use https://.
GITEA_BASE_URL=https://gitea.company.local

# Gitea organization that holds one repository per project.
GITEA_OWNER=sbom

# Branch with the SBOM files.
GITEA_BRANCH=main

# true hides new repositories from users outside the organization.
GITEA_PRIVATE_REPOS=false

# Timeout of one Gitea request.
GITEA_TIMEOUT_SECONDS=60

# Optional service token. Every user of the PC can read it. Empty: each user enters a personal token once.
GITEA_TOKEN=

# Optional accounts or groups for the local group "Siemens TIA Openness", comma separated, e.g. COMPANY\TIA-Users
OPENNESS_MEMBERS=

# TIA installation root, change it only for a non-default path.
# TIA_ROOT=C:\Program Files\Siemens\Automation

# Add-In folder per TIA version. Defaults: Vnn\AddIns in the TIA folder, V21 %APPDATA%\...\UserAddIns.
# TIA shows the folder it uses in Add-ins > Details > Path.
# ADDIN_DIR_V21=C:\ProgramData\Siemens\Automation\Portal V21\CorporateAddIns
